LOGIK_BASE_URL="https://your-instance.logik.io"
LOGIK_TOKEN="your-token-here"
# Some Logik instances restrict the runtime API to an allowlist of Origins
# (see the instance's Origins settings in the Logik admin console). If calls
# come back 403 with an empty body, set this to a value that's on that list
# (e.g. http://localhost:3000 locally, the deployed site's URL in production)
# rather than assuming it must match LOGIK_BASE_URL.
LOGIK_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_LOGIK_PRODUCT_ID="your-product-uuid"
NEXT_PUBLIC_LOGIK_PRICEBOOK_ID=

SN_INSTANCE="https://your-instance.service-now.com"
SN_USERNAME="admin"
# If any secret value contains a literal $ (common in generated passwords),
# escape it as \$ — Next.js's .env loader treats an unescaped $NAME as a
# variable reference and silently replaces it with an empty string if no
# such variable exists, truncating the value with no error. A truncated
# password here surfaces as ServiceNow auth failing, which the API route
# then misreports as "account not found" unless you check response.ok
# before parsing (this route does).
SN_PASSWORD="your-password"
SN_ACCOUNT_NAME="Your Account Name"
